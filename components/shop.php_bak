          <h3 class="text-sm font-bold text-black uppercase tracking-wide flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
            </svg>
            Categories
          </h3>
        </div>

        <div class="p-4 max-h-[800px] overflow-y-auto">
          <?php
          // Get all product categories
          $categories = get_terms([
            'taxonomy' => 'product_cat',
            'hide_empty' => true,
            'parent' => 0,
          ]);

          function display_category_tree($category, $level = 0, $selected_cat)
          {
            if ($level > 3)
              return; // Limit to 4 levels (0-3)
          
            $indent = $level * 1;
            $is_selected = ($selected_cat === $category->slug);
            $has_children = get_terms([
              'taxonomy' => 'product_cat',
              'hide_empty' => true,
              'parent' => $category->term_id,
            ]);

            echo '<div class="category-item" style="padding-left: ' . $indent . 'rem;">';
            echo '<a href="' . add_query_arg('product_cat', $category->slug) . '" 
                     class="flex items-center justify-between py-2 px-3 text-sm hover:bg-gray-50 transition-colors ' .
              ($is_selected ? 'bg-gray-50 text-red-800 font-semibold' : 'border-transparent text-gray-700') . '">';
            echo '<span class="flex items-center gap-2">';
            if (!empty($has_children)) {
              echo '<svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>';
            }
            echo esc_html($category->name);
            echo '</span>';
            echo '<span class="text-xs bg-gray-100 px-2 py-0.5 font-bold text-gray-600">' . $category->count . '</span>';
            echo '</a>';

            // Display children recursively
            if (!empty($has_children)) {
              foreach ($has_children as $child) {
                display_category_tree($child, $level + 1, $selected_cat);
              }
            }

            echo '</div>';
          }

          if (!empty($categories)) {
            foreach ($categories as $category) {
              if ($category->slug === 'uncategorized')
                continue;
              display_category_tree($category, 0, $selected_category);
            }
          }
          ?>
        </div>

        <?php if ($selected_category): ?>
          <div class="p-4 border-t">
            <a href="<?php echo strtok($_SERVER['REQUEST_URI'], '?'); ?>"
              class="inline-flex items-center gap-2 text-sm text-red-800 hover:text-red-900 font-semibold">
